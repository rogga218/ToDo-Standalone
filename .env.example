# App Configuration
APP_NAME=ToDo-App
HOST=0.0.0.0
PORT=8080

# Debug (activate hot-reload in development)
DEBUG=False

# Database Configuration (DATABASE_URL overrides SQLITE_FILE_NAME when set)
DATABASE_URL=sqlite:///data/todo.db
#SQLITE_FILE_NAME=todo.db

# Security (Replace with a generated secret in production)
STORAGE_SECRET=change_this_to_a_secure_random_string

# AI Configuration - Get your key from https://aistudio.google.com/
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=LOW
# Optional token budget: 0 to disable thinking, -1 for auto, or integer token limit
# GEMINI_THINKING_BUDGET=0


